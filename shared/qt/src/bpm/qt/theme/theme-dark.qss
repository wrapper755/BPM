/* 생성 파일: design/tokens.json에서 만든다. 직접 고치지 말고 원본을 고친 뒤 scripts/gen_tokens.py (dark) */

QWidget {
  background-color: #090A0C;
  color: #FAFAFA;
  font-family: Geist, "Pretendard Variable", Pretendard, "Malgun Gothic", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
  font-size: 14px;
}

QFrame#Surface, QGroupBox, QDialog {
  background-color: #171717;
  border: 1px solid #3C3C3C;
  border-radius: 8px;
}

/* 묶음(Section, 스타일 가이드 §3) — 제목은 **카드 안쪽 맨 위**에 굵게, 그 아래 옅은 선.
   테두리에 걸친 회색 제목은 내용과 붙어 보여
   묶음이 갈리지 않았다. Qt는 제목 자리를 비워 주지
   않으므로 위 패딩 = 제목 위 여백 + 제목 줄 높이 + 제목 아래 간격으로 직접 연다 (없으면 겹친다, 이슈 #3). */
QGroupBox {
  margin-top: 0;
  font-size: 16px;
  font-weight: 700;
  padding: 45px 8px 8px 8px;
}
QGroupBox::title {
  subcontrol-origin: padding;
  subcontrol-position: top left;
  left: 0;
  top: 12px;
  /* 아래 선 — 제목 칸을 오른쪽으로 길게 늘여 그 밑줄이 묶음 폭을 가로지르게 한다(묶음이 넘친 것을 자른다).
     폭 전체 선은 QSS로 따로 그을 수 없다. 선은 제목 아래 간격의 절반에 오고
     카드 양끝까지 닿는다(제목 글은 왼쪽 패딩으로 들여 쓴다). */
  padding: 0 4000px 6px 12px;
  border-bottom: 1px solid #3C3C3C;
  color: #FAFAFA;
}

/* QWidget 배경이 글자 위젯에도 칠해져 흰 상자 안에 회색 칸이 생긴다 — 글자는 놓인 곳의 배경을 따른다. */
QLabel, QCheckBox, QRadioButton { background-color: transparent; }

QLabel#Secondary { color: #C4C4C4; }
QLabel#Muted { color: #A1A1A1; }

/* 글자의 뜻은 `role` 속성으로 준다 (스타일 가이드 §4-2) — 「빨간 글자로 이유」(U3)가 여기서 빨갛다. */
QLabel[role="error"] { color: #FF9A8F; }
QLabel[role="warning"] { color: #F5B65C; }
QLabel[role="muted"] { color: #A1A1A1; }
QLabel[role="h2"] { font-size: 20px; font-weight: 600; }

/* 주 단추는 **연한 채움**이다 (데스크톱만 — 스타일 가이드 §3 Button). 회색 화면에서 진한 채움 하나가 너무 튄다. */
QPushButton {
  background-color: #222546;
  color: #8B94F4;
  border: 1px solid #8B94F4;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 12px;
  font-weight: 500;
}
QPushButton:hover { color: #9FA9FC; border-color: #9FA9FC; }
QPushButton:focus { border: 2px solid #7078C7; }
QPushButton:disabled {
  background-color: #262626;
  color: #A1A1A1;
  border-color: #3C3C3C;
}

QPushButton#Secondary {
  background-color: #171717;
  color: #FAFAFA;
  border: 1px solid #585858;
}

/* 대화상자 아래 단추 — Qt 표준 아이콘(초록 체크·빨간 X)을 쓰지 않는다 (스타일 가이드 §6).
   우리 아이콘은 `dress_button_box`가 단다. 메시지 상자는 단추를 우리가 짓지 않으니 기본 단추 하나만 채운다. */
QDialogButtonBox { dialogbuttonbox-buttons-have-icons: 0; }
QMessageBox QPushButton:!default {
  background-color: #171717;
  color: #FAFAFA;
  border: 1px solid #585858;
}

QPushButton#Danger {
  background-color: #F2564A;
  color: #0F1115;
}

QToolButton[running="true"] {
  background-color: #8B94F4;
  color: #0C0E1C;
  border-radius: 6px;
}

QLineEdit, QComboBox, QPlainTextEdit, QTextEdit, QSpinBox {
  background-color: #171717;
  color: #FAFAFA;
  border: 1px solid #585858;
  border-radius: 6px;
  min-height: 32px;
  padding: 0 8px;
}
QLineEdit:focus, QComboBox:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus {
  border: 2px solid #7078C7;
}

/* 속성 패널의 편집기 탭 (Studio `EditorHolder`) — 스크롤 영역과 편집기 바탕을 카드와 같은 흰색으로.
   맨 QWidget은 위의 앱 바탕을 칠해 묶음 사이에 회색 띠가 생긴다 (스타일 가이드 §4-2). */
QScrollArea#EditorHolder, QScrollArea#EditorHolder > QWidget#qt_scrollarea_viewport,
QScrollArea#EditorHolder > QWidget#qt_scrollarea_viewport > QWidget {
  background-color: #171717;
}

/* 표 칸 안의 콤보(칸 위젯) — 칸 선에 붙지 않게 띄우고 높이는 줄을 따른다 (스타일 가이드 §4-2). */
QAbstractItemView QComboBox {
  margin: 2px 4px;
  padding: 0 4px;
  min-height: 0;
}

/* QSpinBox에 테두리·둥근 모서리를 입히면 기본 ▲▼ 단추가 그 테두리 위에 그대로 겹쳐 잘린다 (이슈 #3, 150%).
   단추를 테두리 안쪽에 세로로 놓고, 칸 오른쪽에 그 자리를 비운다. */
QSpinBox { padding-right: 24px; }
QSpinBox::up-button, QSpinBox::down-button {
  subcontrol-origin: border;
  width: 20px;
  border: none;
  border-left: 1px solid #3C3C3C;
  background-color: transparent;
}
QSpinBox::up-button {
  subcontrol-position: top right;
  margin: 1px 1px 0 0;
  border-top-right-radius: 6px;
}
QSpinBox::down-button {
  subcontrol-position: bottom right;
  margin: 0 1px 1px 0;
  border-bottom-right-radius: 6px;
}
QSpinBox::up-button:hover, QSpinBox::down-button:hover { background-color: #262626; }
/* 단추를 꾸미면 Qt가 기본 화살표를 그리지 않는다 — 생성한 SVG를 쓴다. `@THEME_DIR@`는 테마를 읽을 때
   그 패키지 폴더의 실제 경로로 바뀐다 (bpm.qt.theme.qss). */
QSpinBox::up-arrow {
  image: url(@THEME_DIR@/arrow-up-dark.svg);
  width: 8px;
  height: 4px;
}
QSpinBox::down-arrow {
  image: url(@THEME_DIR@/arrow-down-dark.svg);
  width: 8px;
  height: 4px;
}

/* QCheckBox·QRadioButton에 **무엇이든** 스타일을 주면 Qt가 기본 표시기를 그리지 않는다 — 체크된 칸이
   상자 없이 ✓만 보였다 (이슈 #3). 표시기를 직접 그린다. ✓는 생성한 SVG다. */
QCheckBox::indicator, QRadioButton::indicator {
  width: 16px;
  height: 16px;
  border: 1px solid #585858;
  background-color: #171717;
}
QCheckBox::indicator { border-radius: 4px; }
QRadioButton::indicator { border-radius: 8px; }  /* 지름의 절반 = 동그라미 */
QCheckBox::indicator:hover, QRadioButton::indicator:hover { border-color: #8B94F4; }
QCheckBox::indicator:checked {
  background-color: #8B94F4;
  border-color: #8B94F4;
  image: url(@THEME_DIR@/check-dark.svg);
}
QRadioButton::indicator:checked {
  background-color: #171717;
  border-color: #8B94F4;
  image: url(@THEME_DIR@/dot-dark.svg);
}
QCheckBox::indicator:disabled, QRadioButton::indicator:disabled {
  background-color: #262626;
  border-color: #3C3C3C;
}

QHeaderView::section {
  background-color: #262626;
  color: #C4C4C4;
  border: none;
  border-bottom: 1px solid #3C3C3C;
  height: 32px;
  padding: 0 8px;
}
QTableView, QTreeView, QListView {
  background-color: #171717;
  alternate-background-color: #090A0C;
  border: 1px solid #3C3C3C;
  border-radius: 8px;
}
QTableView::item:selected, QTreeView::item:selected, QListView::item:selected {
  background-color: #222546;
  color: #FAFAFA;
}

/* 작업 영역(STU-01) — 영역마다 카드(흰 바탕 + 테두리)이고 사이는 바탕색 틈이 가른다. 선을 긋지 않는다
   (선은 옆 영역의 테두리와 겹쳐 두 겹이 된다). 틈이 곧 끌어서 크기를 바꾸는 자리다. */
QSplitter::handle, QMainWindow::separator { background-color: transparent; }
QSplitter::handle:horizontal, QMainWindow::separator:horizontal { width: 8px; }
QSplitter::handle:vertical, QMainWindow::separator:vertical { height: 8px; }
QFrame#Pane, QTabWidget#PaneTabs::pane {
  background-color: #171717;
  border: 1px solid #3C3C3C;
  border-radius: 8px;
}
QTabWidget#PaneTabs::pane { top: -1px; border-top-left-radius: 0; }
/* 카드 안의 첫 목록은 카드의 테두리를 쓴다 — 제 테두리를 또 그리면 두 겹이다. */
QTabWidget#PaneTabs > QStackedWidget > QAbstractScrollArea,
QTabWidget#PaneTabs > QStackedWidget > QWidget > QAbstractScrollArea {
  border: none;
  border-radius: 0;
}
/* 틈 — 카드보다 한 단계 가라앉는다. 메인 창과 그 안의 감싸개만 (`Workspace`) — 대화상자는 그대로다. */
QMainWindow[workspace="true"], QMainWindow[workspace="true"] > QDockWidget,
QMainWindow[workspace="true"] > QStatusBar, QWidget#Workspace,
QSplitter#middleSplit, QSplitter#bottomSplit { background-color: #090A0C; }
/* 카드 머리띠 — 캔버스·속성처럼 탭이 없는 카드. 위 모서리는 카드의 둥글기 안쪽에 맞춘다. */
QLabel#PaneHeader {
  background-color: #262626;
  color: #C4C4C4;
  font-weight: 600;
  padding: 4px 12px;
  border-bottom: 1px solid #3C3C3C;
  border-top-left-radius: 7px;
  border-top-right-radius: 7px;
}
/* 탭 (스타일 가이드 §3 Tabs) — 앱의 **모든 탭이 한 모양**이다. 탭이 있는 카드는 탭 줄이 곧 머리띠다.
   고른 탭은 흰 바탕 + 굵게 + **연한 보라 밑줄**(`focus`) — `primary` 밑줄은 너무 셌다.
   밑줄 자리는 다른 탭도 같은 두께로 비워(머리 바탕색) 고를 때 높이가 바뀌지 않는다. */
QTabWidget#PaneTabs > QTabBar { background-color: transparent; }
QTabBar::tab {
  background-color: #262626;
  color: #C4C4C4;
  border: 1px solid #3C3C3C;
  border-bottom: 2px solid #262626;
  padding: 4px 12px;
  margin-right: 2px;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
}
QTabBar::tab:selected {
  background-color: #171717;
  color: #FAFAFA;
  font-weight: 600;
  border-bottom: 2px solid #7078C7;
}
QTabBar::tab:!selected:hover { color: #FAFAFA; }

/* 위 띠 (STU-01 [M]·[B]) — 메뉴 막대와 도구 모음이 하나로 이어진 연한 보라 띠. `band` 속성을 단 창만이다.
   남색 틀(`chrome.*`)은 데스크톱 창 위에서 너무 셌다 — 브랜드 색의 옅은 단계에 보통 글자를 얹는다. */
QMenuBar[band="true"] {
  background-color: #222546;
  color: #FAFAFA;
  padding: 4px 8px 0 8px;
}
QMenuBar[band="true"]::item {
  background-color: transparent;
  color: #FAFAFA;
  padding: 4px 8px;
  border-radius: 4px;
}
QMenuBar[band="true"]::item:selected, QMenuBar[band="true"]::item:pressed {
  background-color: #171717;
}
QToolBar[band="true"] {
  background-color: #222546;
  border: none;
  border-bottom: 1px solid #3C3C3C;
  padding: 4px 8px;
  spacing: 4px;
}
QToolBar[band="true"] QToolButton {
  background-color: transparent;
  color: #FAFAFA;
  border: none;
  border-radius: 6px;
  padding: 4px 8px;
}
QToolBar[band="true"] QToolButton:hover, QToolBar[band="true"] QToolButton:checked {
  background-color: #171717;
}
QToolBar[band="true"] QToolButton:disabled { color: #A1A1A1; }
QToolBar[band="true"] QToolButton[running="true"] { background-color: #8B94F4; color: #0C0E1C; }
QToolBar[band="true"]::separator {
  background-color: #585858;
  width: 1px;
  margin: 4px 8px;
}

/* 무리 아래 선 (STU-01 「변수」 탭) — 작은 탭과 그 아래 표를 가른다. */
QFrame#Rule {
  background-color: #3C3C3C;
  border: none;
  max-height: 1px;
  min-height: 1px;
}

/* 펼친 메뉴(메뉴 막대·문맥 메뉴) — 테두리가 없으면 흰 바탕 위에서 메뉴가 어디까지인지 안 보인다. */
QMenu {
  background-color: #171717;
  color: #FAFAFA;
  border: 1px solid #585858;
  padding: 4px 0;
}
QMenu::item { padding: 4px 24px 4px 12px; }
QMenu::item:selected { background-color: #8B94F4; color: #0C0E1C; }
QMenu::item:disabled { color: #A1A1A1; }
QMenu::separator { height: 1px; background-color: #3C3C3C; margin: 4px 8px; }

QToolTip {
  background-color: #FAFAFA;
  color: #0F1115;
  border: none;
  padding: 4px 8px;
}

QProgressBar {
  background-color: #262626;
  border: none;
  border-radius: 9999px;
  height: 8px;
  text-align: center;
}
QProgressBar::chunk { background-color: #5B8CFF; border-radius: 9999px; }
