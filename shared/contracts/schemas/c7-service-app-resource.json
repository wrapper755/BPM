      "title": "Extension Id"
    },
    "groups": {
      "items": {
        "$ref": "#/$defs/OperationGroup"
      },
      "title": "Groups",
      "type": "array"
    },
    "keywords": {
      "items": {
        "type": "string"
      },
      "title": "Keywords",
      "type": "array"
    },
    "manifest_at": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
