{
  "$id": "urn:bpm:contracts:c15-fetch-request",
  "additionalProperties": true,
  "description": "`POST /api/v1/consumers/fetch` — 가져가기 (롱폴링).",
  "properties": {
    "lock_s": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lock S"
    },
    "max_tasks": {
      "default": 1,
      "minimum": 0,
      "title": "Max Tasks",
      "type": "integer"
    },
    "name": {
      "anyOf": [
        {
          "maxLength": 64,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Name"
    },
    "topics": {
      "items": {
        "pattern": "^[a-z0-9][a-z0-9.-]{0,63}$",
        "type": "string"
      },
      "minItems": 1,
      "title": "Topics",
      "type": "array"
    },
    "wait_s": {
      "default": 25,
      "minimum": 0,
      "title": "Wait S",
      "type": "integer"
    }
  },
  "required": [
    "topics"
  ],
  "title": "FetchRequest",
  "type": "object"
}
