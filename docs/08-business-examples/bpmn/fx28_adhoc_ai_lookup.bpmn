<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xmlns:bpm="urn:chaeksas:bpmn:1"
  id="Defs_fx28_adhoc_ai_lookup" targetNamespace="urn:chaeksas:examples" exporter="bpm-examples" exporterVersion="1">
  <bpmn:process id="Proc_fx28_adhoc_ai_lookup" name="필요한 조회만 하는 문의 답변 (Ad Hoc — AI)" isExecutable="true">
    <bpmn:extensionElements>
      <bpm:process>{
  "extensions": [],
  "outputs": [],
  "inputs": [
    {
      "name": "문의",
      "type": "string",
      "required": true,
      "description": "고객이 보낸 글"
    }
  ]
}</bpm:process>
    </bpmn:extensionElements>
    <bpmn:startEvent id="Start" name="시작">
      <bpmn:outgoing>Flow_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:adHocSubProcess id="Sub_Answer" name="문의에 답하기" ordering="Parallel" cancelRemainingInstances="true">
      <bpmn:extensionElements>
        <bpm:adHoc>{
  "ai": {
    "goal": "## 상황\n고객 `문의` 한 건이 왔다. 활동의 결과는 `주문상태`·`환불규정`·`메모`에 담긴다.\n\n## 할 일\n필요한 활동만 골라 켜고, 결과를 보고 고객에게 보낼 답을 한 문단으로 쓴다.\n\n## 판단하지 않는 것\n환불을 약속하지 않는다.\n\n## 반환\n- `문의답변`: string",
    "results": {
      "문의답변": "string"
    },
    "limits": {
      "max_steps": 5
    }
  }
}</bpm:adHoc>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_01</bpmn:incoming>
      <bpmn:outgoing>Flow_02</bpmn:outgoing>
      <bpmn:scriptTask id="Look_Order" name="주문 조회" scriptFormat="bpm-expr">
        <bpmn:script>주문상태 = '배송 중'</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:scriptTask id="Look_Refund" name="환불 규정 확인" scriptFormat="bpm-expr">
        <bpmn:script>환불규정 = '받은 날부터 7일 안'</bpmn:script>
      </bpmn:scriptTask>
      <bpmn:userTask id="Ask_Agent" name="상담원 확인">
        <bpmn:extensionElements>
          <bpm:approval>{
  "title": "문의 확인",
  "description": "",
  "show": [
    "문의"
  ],
  "fields": [
    {
      "key": "메모",
      "label": "상담원 메모",
      "type": "text",
      "required": false
    }
  ]
}</bpm:approval>
        </bpmn:extensionElements>
      </bpmn:userTask>
    </bpmn:adHocSubProcess>
    <bpmn:endEvent id="End" name="끝">
      <bpmn:incoming>Flow_02</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_01" sourceRef="Start" targetRef="Sub_Answer" />
    <bpmn:sequenceFlow id="Flow_02" sourceRef="Sub_Answer" targetRef="End" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Proc_fx28_adhoc_ai_lookup">
      <bpmndi:BPMNShape id="Start_di" bpmnElement="Start"><dc:Bounds x="160" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="140" y="322" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Sub_Answer_di" bpmnElement="Sub_Answer" isExpanded="true"><dc:Bounds x="266" y="80" width="160" height="440" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Look_Order_di" bpmnElement="Look_Order"><dc:Bounds x="296" y="110" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Look_Refund_di" bpmnElement="Look_Refund"><dc:Bounds x="296" y="260" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ask_Agent_di" bpmnElement="Ask_Agent"><dc:Bounds x="296" y="410" width="100" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_di" bpmnElement="End"><dc:Bounds x="496" y="282" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="476" y="322" width="76" height="27" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_01_di" bpmnElement="Flow_01"><di:waypoint x="196" y="300" /><di:waypoint x="266" y="300" /></bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_02_di" bpmnElement="Flow_02"><di:waypoint x="426" y="300" /><di:waypoint x="496" y="300" /></bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>
