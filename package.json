{
  "name": "bpm",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./server/web/apps/*\" dev",
    "build": "pnpm --filter \"./server/web/apps/*\" build",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "gen:api-types": "pnpm --filter @bpm/api-types generate",
    "check:api-types": "pnpm --filter @bpm/api-types check"
  },
  "devDependencies": {
    "vitest": "5.0.4"
  }
}
