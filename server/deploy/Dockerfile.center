# Center API 컨테이너 (ADR-0017 §1 — 서버는 Linux 주).
# uv로 의존성을 받고, 워크스페이스 멤버만 설치한다 (server/web/·spikes/는 들어가지 않는다).
FROM python:3.12-slim AS base

# uv는 공식 이미지에서 복사한다 (버전을 고정해 재현되게).
COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    # **이미지의 Python을 쓴다.** 그냥 두면 uv가 자기 Python을 `/root/.local/...`에 내려받고
    # venv를 거기로 잇는데, `/root`는 0700이라 비관리자로 돌 때 인터프리터에 닿지 못한다
    # (`failed to canonicalize path /app/.venv/bin/python3: Permission denied`).
    UV_PYTHON_PREFERENCE=only-system \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

# 잠금 파일과 멤버 선언만 먼저 복사해 레이어 캐시를 살린다.
COPY pyproject.toml uv.lock .python-version ./
COPY shared/contracts/pyproject.toml shared/contracts/
COPY shared/extension_api/pyproject.toml shared/extension_api/
COPY shared/core/pyproject.toml shared/core/
COPY shared/llm/pyproject.toml shared/llm/
COPY shared/qt/pyproject.toml shared/qt/
COPY server/service_kit/pyproject.toml server/service_kit/
COPY server/center/pyproject.toml server/center/
COPY studio/app/pyproject.toml studio/app/
COPY bot/app/pyproject.toml bot/app/
COPY server/server_runner/pyproject.toml server/server_runner/

# Center가 쓰는 것만 설치한다 (Qt·PySide6는 서버에 필요 없다).
RUN uv sync --frozen --no-install-workspace --package bpm-center

COPY shared/ shared/
COPY server/service_kit/ server/service_kit/
COPY server/center/ server/center/
RUN uv sync --frozen --package bpm-center

# 데이터는 볼륨에 둔다 (DB·패키지 파일).
ENV BPM_CENTER__DATA_DIR=/data
VOLUME ["/data"]
EXPOSE 8800

# 컨테이너 안에서는 비관리자로 돈다.
RUN useradd --create-home --uid 10001 bpm && mkdir -p /data && chown -R bpm /data /app
USER bpm

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s \
  CMD python -c "import urllib.request;urllib.request.urlopen('http://127.0.0.1:8800/healthz')"

CMD ["uv", "run", "--frozen", "--package", "bpm-center", "bpm-center"]
