# 통합 일꾼 컨테이너 — Center의 외부 작업을 가져가 수행한다 (C15, ADR-0135·0140).
# `Dockerfile.server-runner`와 같은 뼈대다. **업무 처리기는 들어 있지 않다** — 이 이미지만으로는 외부 확장 정의
# (`BPM_CONSUMER__DEFINITIONS`)만 돌리는 API 일꾼이다. 회사의 업무 처리기는 이 이미지를 `FROM`으로 받아 패키지만
# 더한 이미지로 얹는다 (`server/deploy/README.md` §통합 일꾼).
FROM python:3.12-slim AS base

COPY --from=ghcr.io/astral-sh/uv:0.9.9 /uv /usr/local/bin/uv

ENV UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONUTF8=1 \
    # **이미지의 Python을 쓴다** (Dockerfile.center와 같은 이유 — `/root`는 0700이다).
    UV_PYTHON_PREFERENCE=only-system \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /app

COPY pyproject.toml uv.lock .python-version ./
COPY shared/contracts/pyproject.toml shared/contracts/
COPY shared/extension_api/pyproject.toml shared/extension_api/
COPY shared/core/pyproject.toml shared/core/
COPY shared/llm/pyproject.toml shared/llm/
COPY server/service_kit/pyproject.toml server/service_kit/
COPY server/center/pyproject.toml server/center/
COPY server/server_runner/pyproject.toml server/server_runner/
COPY server/adapter_consumer/pyproject.toml server/adapter_consumer/
COPY server/unified_consumer/pyproject.toml server/unified_consumer/

# 일꾼이 쓰는 것만.
RUN uv sync --frozen --no-install-workspace --package bpm-unified-consumer

COPY shared/ shared/
COPY server/service_kit/ server/service_kit/
COPY server/adapter_consumer/ server/adapter_consumer/
COPY server/unified_consumer/ server/unified_consumer/
RUN uv sync --frozen --package bpm-unified-consumer

# 처리기 이미지가 `uv pip install --python /app/.venv/bin/python <패키지>`로 더한 패키지가 **다시 맞춰지지 않게**
# `uv run`이 아니라 가상 환경의 실행 파일을 바로 부른다. 처리기가 끌어오는 `bpm-*`는 이미 깔려 있어 받지 않는다.
ENV PATH=/app/.venv/bin:$PATH \
    BPM_CONSUMER__DATA_DIR=/data \
    # 관리 API(일꾼 콘솔이 부른다)는 compose 망 안에서만 닿는다 — 포트를 호스트에 내지 않는다.
    BPM_CONSUMER__HOST=0.0.0.0
VOLUME ["/data"]

RUN useradd --create-home --uid 10001 bpm \
 && mkdir -p /data && chown -R bpm /data /app
USER bpm

CMD ["bpm-unified-consumer"]
